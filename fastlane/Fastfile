# Release tooling for Claude Usage Trend Tracker.
#
# The archive/export work still lives in scripts/build-testflight.sh — this file
# only wraps it so the tracker ships through the same standard fastlane path as
# Snap Shoot Share rather than a bespoke xcodebuild upload invocation.

API_KEY_PATH = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_XG3FW9LT9Q.p8")

API_KEY = lambda {
  app_store_connect_api_key(
    key_id: "XG3FW9LT9Q",
    issuer_id: "178bab61-1c45-4f62-9525-55f8ed15a98d",
    key_filepath: API_KEY_PATH,
    in_house: false
  )
}

BUNDLE_ID = "com.theportlandcompany.ClaudeMeter"
INTERNAL_GROUP = "Internal Testers"
PROJECT_ROOT = File.expand_path("..", __dir__)

def project_version(key)
  File.read(File.join(PROJECT_ROOT, "project.yml"))[/#{key}:\s*"([^"]+)"/, 1]
end

platform :mac do
  desc "Archive, export a signed .pkg, and upload it to TestFlight"
  lane :beta do
    version = project_version("MARKETING_VERSION")
    build = project_version("CURRENT_PROJECT_VERSION")
    UI.message("Releasing #{version} (#{build})")

    sh("cd '#{PROJECT_ROOT}' && scripts/build-testflight.sh")

    pkg = File.join(PROJECT_ROOT, "dist", "ClaudeUsageTrendTracker-#{version}-#{build}.pkg")
    UI.user_error!("expected package missing: #{pkg}") unless File.exist?(pkg)

    upload_to_testflight(
      api_key: API_KEY.call,
      pkg: pkg,
      app_identifier: BUNDLE_ID,
      # Builds 15-17 uploaded fine but sat at READY_FOR_BETA_TESTING because
      # nothing ever added them to a group, so TestFlight kept offering build 14.
      # Waiting for processing is what lets pilot do the group assignment.
      skip_waiting_for_build_processing: false,
      distribute_external: false,
      groups: [INTERNAL_GROUP]
    )
  end

  desc "Add the newest processed build to the internal tester group"
  lane :distribute do
    require 'spaceship'
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: "XG3FW9LT9Q",
      issuer_id: "178bab61-1c45-4f62-9525-55f8ed15a98d",
      filepath: API_KEY_PATH
    )
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    group = app.get_beta_groups.find { |g| g.name == INTERNAL_GROUP }
    UI.user_error!("no group named #{INTERNAL_GROUP}") if group.nil?
    build = app.get_builds(includes: "preReleaseVersion,buildBetaDetail")
               .find { |b| b.processing_state == "VALID" }
    UI.user_error!("no VALID build") if build.nil?
    UI.message("adding #{build.pre_release_version&.version}(#{build.version}) to #{INTERNAL_GROUP}")
    build.add_beta_groups(beta_groups: [group])
    UI.success("distributed")
  end

  desc "Diagnose why builds are not reaching TestFlight"
  lane :tf_detail do
    require 'spaceship'
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: "XG3FW9LT9Q",
      issuer_id: "178bab61-1c45-4f62-9525-55f8ed15a98d",
      filepath: API_KEY_PATH
    )
    ["com.theportlandcompany.ClaudeMeter", "com.spencerhill.screenshoter"].each do |bid|
      app = Spaceship::ConnectAPI::App.find(bid)
      UI.message("=== #{bid} (#{app.name}) ===")
      app.get_beta_groups.each do |g|
        UI.message("  group: #{g.name} internal=#{g.is_internal_group} id=#{g.id}")
      end
      app.get_builds(includes: "preReleaseVersion,buildBetaDetail").first(3).each do |b|
        d = b.build_beta_detail
        UI.message("  #{b.pre_release_version&.version}(#{b.version}) proc=#{b.processing_state} " \
                   "internal=#{d&.internal_build_state} external=#{d&.external_build_state}")
      end
    end
  end

  desc "List TestFlight builds for this app"
  lane :tf_status do
    require 'spaceship'
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: "XG3FW9LT9Q",
      issuer_id: "178bab61-1c45-4f62-9525-55f8ed15a98d",
      filepath: API_KEY_PATH
    )
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    app.get_builds(includes: "preReleaseVersion").first(10).each do |b|
      UI.message("  #{b.pre_release_version&.version}(#{b.version}) state=#{b.processing_state} uploaded=#{b.uploaded_date}")
    end
  end
end
