<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Store / TestFlight build: sandboxed with outgoing network only.
	     The login-keychain read of "Claude Code-credentials" still works inside
	     the sandbox (file-based keychain access is user-consent gated, not
	     sandbox gated); verified 2026-09-03. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
