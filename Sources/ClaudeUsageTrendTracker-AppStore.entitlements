<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Store / TestFlight build: sandboxed with outgoing network only.
	     The sandbox cannot persist access to another app's login-Keychain item
	     ("Always Allow" is blocked and the process is SIGKILLed), so this build
	     does NOT read "Claude Code-credentials". It gets its token via Sign in
	     with Claude (OAuth) / pairing, stored in the app's own Keychain. The
	     Keychain-reading primary account lives only in the non-sandboxed
	     direct-download build. Gated on the APPSTORE compilation condition. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
